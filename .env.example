# Public site URL (used for Stripe redirect URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe — Developers > API keys (use test keys until you go live)
STRIPE_SECRET_KEY=sk_test_xxx
# From `stripe listen` locally, or the webhook endpoint in the Stripe dashboard
STRIPE_WEBHOOK_SECRET=whsec_xxx
